diff --git a/pm/android_link.py b/pm/android_link.py
new file mode 100644
index 00000000..b6984573
--- /dev/null
+++ b/pm/android_link.py
@@ -0,0 +1,37 @@
+"""Local Termux packaging fix for native wheels with unresolved Python symbols."""
+from pathlib import Path
+import base64
+import csv
+import hashlib
+import io
+import subprocess
+
+
+def link_python_extensions(venv: Path) -> None:
+    site = venv / 'lib/python3.14/site-packages'
+    changed = set()
+    for extension in site.rglob('*.so'):
+        symbols = subprocess.run(['readelf', '-Ws', str(extension)],
+                                 capture_output=True, text=True, check=True).stdout
+        if not any(' UND ' in line and (' Py' in line or ' _Py' in line)
+                   for line in symbols.splitlines()):
+            continue
+        needed = subprocess.run(['patchelf', '--print-needed', str(extension)],
+                                capture_output=True, text=True, check=True).stdout.splitlines()
+        if 'libpython3.14.so' in needed:
+            continue
+        subprocess.run(['patchelf', '--add-needed', 'libpython3.14.so', str(extension)], check=True)
+        changed.add(extension.relative_to(site).as_posix())
+    for record in site.glob('*.dist-info/RECORD'):
+        rows = list(csv.reader(io.StringIO(record.read_text())))
+        updated = False
+        for row in rows:
+            if row[0] in changed:
+                data = (site / row[0]).read_bytes()
+                digest = base64.urlsafe_b64encode(hashlib.sha256(data).digest()).rstrip(b'=').decode()
+                row[1:] = ['sha256=' + digest, str(len(data))]
+                updated = True
+        if updated:
+            with record.open('w', newline='') as handle:
+                csv.writer(handle).writerows(rows)
+    print(f'Android: linked {len(changed)} native Python extensions to libpython3.14.so')
